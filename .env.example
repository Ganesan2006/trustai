# Copy this file to .env and replace the placeholders with your own values.
# Never commit .env or put real secrets in this file.

# PostgreSQL connection string
DATABASE_URL=postgresql://DB_USER:DB_PASSWORD@DB_HOST:5432/DB_NAME

# JWT signing secret; generate a strong random value, for example:
# openssl rand -hex 32
SECRET_KEY=replace-with-a-random-secret
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Fernet key used to encrypt provider API keys stored in the database.
# Generate a valid key with:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=replace-with-a-valid-fernet-key

# Supabase Storage credentials (required by the storage integration).
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-with-your-supabase-service-role-key
SUPABASE_BUCKET=turstai

# Qdrant vector database (optional in settings; needed for vector search).
QDRANT_URL=https://YOUR_CLUSTER.cloud.qdrant.io:6333
QDRANT_API=replace-with-your-qdrant-api-key
QDRANT_COLLECTION_PREFIX=org_

# OpenAI-compatible LLM endpoint (optional; user-specific provider keys may be used instead).
OPENAI_API_KEY=replace-with-your-model-provider-api-key
OPENAI_BASE_URL=https://api.groq.com/openai/v1
OPENAI_DEFAULT_MODEL=openai/gpt-oss-20b
